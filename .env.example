# Copy file này thành .env

# ---- Máy chủ ----
# 127.0.0.1 = chỉ máy này (dùng khi có tunnel). 0.0.0.0 = cả lớp cùng Wi-Fi vào bằng IP máy
HOST=127.0.0.1
PORT=8889
TLS_HOST=0.0.0.0
TLS_PORT=443
# Trang tĩnh được phép gọi. "*" = mọi nguồn. Muốn siết: nhiều nguồn cách nhau dấu phẩy
ALLOWED_ORIGINS=*
# ---- HTTPS trực tiếp (không qua Cloudflare Tunnel) ----
# Định dạng: url;<link>  |  file;<đường dẫn>  |  none. Để trống = dùng http
# Cần cả cert (fullchain.pem) và khóa (privkey.pem).
# HTTPS_CERT=url;https://github.com/vincentng295/gateway-magic.huskydg.dpdns.org-cert/releases/download/cert/fullchain.pem
# HTTPS_KEY=url;https://github.com/vincentng295/gateway-magic.huskydg.dpdns.org-cert/releases/download/cert/privkey.pem
# or HTTPS_CERT=file;./fullchain.pem
#    HTTPS_KEY=file;./privkey.pem
# HTTPS_CERT=none
# Nếu bỏ trống HTTPS_KEY mà HTTPS_CERT là url kết thúc bằng fullchain.pem thì tự lấy privkey.pem cùng thư mục.
# Chỉ truy cập được bằng đúng tên miền của cert (vd https://gateway-magic.huskydg.dpdns.org:8888), không phải IP.
# HTTPS_CERT=none
# Số giờ giữa các lần tự tải lại cert (cert gia hạn sẽ được nạp mà không cần khởi động lại). Mặc định 12.
# TLS_REFRESH_HOURS=12

# Chỉ chấp nhận request có header Host khớp danh sách (cách nhau dấu phẩy, bỏ qua cổng, hỗ trợ *.ten-mien.com).
# Để trống hoặc "*" = chấp nhận mọi Host. Lưu ý: nếu bật TUNNEL thì phải thêm cả TUNNEL_HOST vào danh sách.
# ALLOWED_HOSTS=example.com,*.example.com,127.0.0.1,localhost
ALLOWED_HOSTS=*
QUESTION_FILE=./question.json

# ---- Cloudflare Tunnel ----
TUNNEL=true
# Domain của game này (phải trỏ tới http://localhost:PORT trong Zero Trust > Networks > Tunnels > Public hostname)
TUNNEL_HOST=flag-ai.huskydg.io.vn
# Token của tunnel. Để trống = domain tạm trycloudflare.com (không cần tài khoản)
TUNNEL_TOKEN=

# ---- Luật chơi (không bắt buộc) ----
READ_SECONDS=10
PLAY_SECONDS=170
RESULT_SECONDS=12
HP=3
DOWN_SECONDS=5
POINTS_CORRECT=100
POINTS_WRONG=-50
POINTS_KILL=20
# Đứng yên, không thao tác quá chừng này giây giữa round thì bot chơi thay tạm thời (0 = tắt)
AFK_SECONDS=60

# ---- Tim hồi máu / súng tên lửa / nâng cấp (không bắt buộc) ----
HEART_RESPAWN=20
ROCKET_RESPAWN=45
# Số lần nâng cấp tối đa của một đội (đội trả lời đúng round trước thì round sau mạnh hơn), tối đa 3
UPGRADE_MAX=3

# ---- Liên kết 2 server (không bắt buộc) ----
# Để trống NODE_ID hoặc LINK_SECRET = tắt liên kết, game chạy một máy như cũ (mã phòng vẫn là 4 chữ số).
# Bật: mã phòng có tiền tố NODE_ID (vd. lan-4821). Phòng nằm trên máy của người tạo, máy kia chuyển tiếp người chơi qua link.
# Tên duy nhất của máy này (chỉ chữ thường/số/_), mỗi máy một tên khác nhau: lan / vps
NODE_ID=
# Khoá dùng chung để xác thực HMAC hai đầu, phải GIỐNG HỆT nhau trên hai máy. Đặt chuỗi dài, ngẫu nhiên.
LINK_SECRET=
# Chỉ đặt ở MỘT bên (thường là máy LAN, để không phải mở cổng): địa chỉ link của máy kia. Bên còn lại để trống = chỉ nghe.
# LINK_PEER_URL=wss://flag-ai.huskydg.io.vn/_link
# Đường dẫn nhận link (bên nghe). Nếu dùng cloudflared, domain trỏ tới máy này phải cho đi qua WebSocket (mặc định đã cho)
# và domain phải nằm trong ALLOWED_HOSTS (nếu bạn siết ALLOWED_HOSTS).
LINK_PATH=/_link
# Tuỳ chọn: chỉ nhận link từ IP này (cách nhau dấu phẩy). Qua cloudflared thì IP lấy từ header CF-Connecting-IP.
LINK_ALLOW_IP=
LINK_PING_SECONDS=5
# Quá chừng này giây không nhận được gói nào thì coi link rớt
LINK_TIMEOUT_SECONDS=15
# Nối lại với độ trễ tăng dần (1s, 2s, 4s...) tới tối đa chừng này giây
LINK_RECONNECT_MAX_SECONDS=30
# Phòng mới tạo đặt ở đâu: local = máy người tạo | tên NODE_ID của máy kia (vd. vps) = luôn đặt phòng ở máy đó (khi link đang nối)
LINK_ROOM_POLICY=local
# Hiện phòng của máy kia trong lobby
LINK_SHARE_ROOMS=true
# Số người chơi/khán giả từ máy kia tối đa qua link
LINK_MAX_REMOTE=100
# Người vào lại (rejoin) đúng lúc link đang rớt: chờ link nối lại tối đa chừng này giây rồi mới báo không vào lại được
LINK_REJOIN_WAIT_SECONDS=25

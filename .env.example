# Copy file này thành flag.env (cạnh flag_server.py) rồi sửa.
# Tách riêng khỏi .env của snake-AI nên chạy song song hai game không bị đè cổng/tunnel.

# ---- Máy chủ ----
# 127.0.0.1 = chỉ máy này (dùng khi có tunnel). 0.0.0.0 = cả lớp cùng Wi-Fi vào bằng IP máy
HOST=127.0.0.1
PORT=8889
# Trang tĩnh được phép gọi. "*" = mọi nguồn. Muốn siết: nhiều nguồn cách nhau dấu phẩy
ALLOWED_ORIGINS=*
# Chỉ chấp nhận request có header Host khớp danh sách (bỏ qua cổng, hỗ trợ *.ten-mien.com).
# Nếu bật TUNNEL thì phải thêm cả TUNNEL_HOST vào danh sách. "*" = chấp nhận mọi Host.
ALLOWED_HOSTS=*
QUESTION_FILE=./question.json

# ---- Cloudflare Tunnel ----
TUNNEL=true
# Domain của game này (phải trỏ tới http://localhost:PORT trong Zero Trust > Networks > Tunnels > Public hostname)
TUNNEL_HOST=flag-ai.huskydg.io.vn
# Token của tunnel. Để trống = domain tạm trycloudflare.com (không cần tài khoản)
TUNNEL_TOKEN=

# ---- Luật chơi (không bắt buộc) ----
READ_SECONDS=10
PLAY_SECONDS=170
RESULT_SECONDS=12
HP=3
DOWN_SECONDS=5
POINTS_CORRECT=100
POINTS_WRONG=-50
POINTS_KILL=20
